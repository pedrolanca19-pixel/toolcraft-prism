{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --base /demos/prism-flow/",
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/demos/prism-flow", "permanent": false }
  ],
  "rewrites": [
    { "source": "/demos/prism-flow/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/demos/prism-flow", "destination": "/index.html" },
    { "source": "/demos/prism-flow/:path*", "destination": "/index.html" }
  ]
}
